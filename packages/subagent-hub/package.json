{
  "name": "dsh-subagent-hub",
  "version": "0.10.1",
  "description": "Named roles, model route guards, native configuration, and request-model visibility for official DeepSeek Harness subagents.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ccsert/dsh-subagent-hub.git",
    "directory": "packages/subagent-hub"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib",
    "locale/*.json",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/*.test.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.2.1-rc.2 <0.3"
  },
  "dependencies": {
    "js-yaml": "^4.1.0"
  },
  "homepage": "https://github.com/ccsert/dsh-subagent-hub#readme",
  "bugs": {
    "url": "https://github.com/ccsert/dsh-subagent-hub/issues"
  },
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh-plugin",
    "subagents",
    "agent-presets",
    "model-routing"
  ]
}
