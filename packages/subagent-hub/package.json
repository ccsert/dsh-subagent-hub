{
  "name": "dsh-subagent-hub",
  "version": "0.3.0",
  "description": "Named subagents, capability-based child model routing, a delegate tool, and a subagent routing panel for DeepSeek Harness.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ccsert/dsh-subagent-hub.git",
    "directory": "packages/subagent-hub"
  },
  "exports": {
    ".": "./lib/index.js",
    "./delegate": "./lib/delegate.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./delegate/locale/*.json": "./delegate/locale/*.json",
    "./delegate/icon": "./icon.svg"
  },
  "files": [
    "lib",
    "locale/*.json",
    "delegate/locale/*.json",
    "icon.svg",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "test": "node --test test/*.test.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.2.1-rc.2 <0.3"
  },
  "dependencies": {
    "js-yaml": "^4.1.0"
  }
}
